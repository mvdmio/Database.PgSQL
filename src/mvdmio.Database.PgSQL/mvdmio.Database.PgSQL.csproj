<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Project configuration">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package configuration">
    <Version>$(PgSqlVersion)</Version>
    <Title>mvdmio.Database.PgSQL</Title>
    <Description>PostgreSQL database interaction including migrations.</Description>
    <Company>mvdmio</Company>
    <Authors>Michiel van der Meer</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
    <IncludeSource>true</IncludeSource>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" PackagePath="" Pack="true"/>
    <None Include="..\..\LICENSE" PackagePath="" Pack="true"/>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\"/>
  </ItemGroup>

  <!--
    The generator ships here rather than as a package of its own: generated code calls into this library's API, so
    the two must version-lock, and two packages would make skew expressible.

    Added once, not per target framework. Pack collects Pack="true" None items in the outer build, so this project's
    three frameworks contribute one copy between them; an item added per framework would land the same file three
    times and warn. An analyzers/ folder flows to transitive consumers on its own, so build/ and buildTransitive/
    need no change.

    The path is spelled out because the outer build has no @(Analyzer) item to read it from — that is resolved per
    framework, after this runs. Naming the file rather than globbing it means a missing analyzer build fails the
    pack instead of quietly producing the package without the generator, which is the defect this exists to close.
  -->
  <ItemGroup>
    <None Include="..\mvdmio.Database.PgSQL.Analyzers\bin\$(Configuration)\netstandard2.0\mvdmio.Database.PgSQL.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false"/>
  </ItemGroup>

  <ItemGroup Label="Internals visible outside the assembly">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>mvdmio.Database.PgSQL.Tests.Unit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>mvdmio.Database.PgSQL.Tests.Integration</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>mvdmio.Database.PgSQL.Tests.Integration.OData</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the analyzer so it ships inside the NuGet package and runs for consumers -->
    <ProjectReference Include="..\mvdmio.Database.PgSQL.Analyzers\mvdmio.Database.PgSQL.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="contentfiles;analyzers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66"/>
    <PackageReference Include="linq2db" Version="6.3.0" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Portable.System.DateTimeOnly" Version="9.0.1"/>

    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
